flowchart TB
    title[<b>系统部署架构图</b><br/><small>Docker 容器化部署 · 高可用主从架构 · Keepalived VIP 漂移</small>]
    style title fill:#ffffff,stroke:#ffffff,color:#0d47a1

    user([互联网用户])

    subgraph VIPLayer["虚拟 VIP（Keepalived） · 公网入口 · 172.20.0.100"]
        vip{{虚拟 VIP<br/>Keepalived}}
    end
    user --> vip

    subgraph NginxLayer["Nginx 负载均衡层 · Keepalived VIP 漂移"]
        nginx1["Nginx-1（Master）<br/>反向代理 · SSL 终结 · 负载均衡<br/>宿主机端口 443 / 80<br/>nginx:1.25-alpine"]
        nginx2["Nginx-2（Backup）<br/>反向代理 · SSL 终结 · 负载均衡<br/>宿主机端口 443 / 80<br/>nginx:1.25-alpine"]
    end
    vip --> nginx1 & nginx2
    nginx1 -.->|Keepalived 心跳 · 配置同步| nginx2

    subgraph GatewayLayer["API 网关层 · Spring Cloud Gateway"]
        gw1["API Gateway-1<br/>路由转发 · 令牌校验 · 限流熔断<br/>Spring Cloud Gateway<br/>gateway:2.1"]
        gw2["API Gateway-2<br/>路由转发 · 令牌校验 · 限流熔断<br/>Spring Cloud Gateway<br/>gateway:2.1"]
    end
    nginx1 --> gw1
    nginx2 --> gw2
    gw1 -.->|路由规则同步 · 令牌共享| gw2

    subgraph AppLayer["情报共享应用层 · Spring Boot 微服务"]
        app1["情报共享-1（cac-intelligence-share）<br/>Spring Boot · Sa-Token · MyBatis-Plus<br/>JVM: -Xms512m<br/>cac-intelligence-share:latest"]
        app2["情报共享-2（cac-intelligence-share）<br/>Spring Boot · Sa-Token · MyBatis-Plus<br/>JVM: -Xms512m<br/>cac-intelligence-share:latest"]
    end
    gw1 --> app1
    gw2 --> app2
    app1 -.->|无状态服务 · 令牌透传 · 缓存共享| app2

    subgraph DBLayer["达梦数据库层 · DM8 主从架构"]
        db1["达梦 DM8-1（Master）<br/>读写 · 主库 · 端口 5236<br/>数据卷: dm8_data_1:/opt/dmdbms/data<br/>dm8:8.1.2.128"]
        db2["达梦 DM8-2（Standby）<br/>只读 · 备库 · 端口 5236<br/>数据卷: dm8_data_2:/opt/dmdbms/data<br/>dm8:8.1.2.128"]
    end
    app1 --> db1
    app2 --> db2
    db1 -.->|主从复制 · 归档日志实时同步 · 读写分离| db2

    subgraph RedisLayer["Redis 缓存层 · JetCache 两级缓存"]
        redis1["Redis-1（Master）<br/>JetCache 两级缓存 · 端口 6379<br/>maxmemory 512mb · 数据卷: redis_data_1<br/>redis:7.0-alpine"]
        redis2["Redis-2（Replica）<br/>只读副本 · 端口 6379<br/>maxmemory 512mb · 数据卷: redis_data_2<br/>redis:7.0-alpine"]
    end
    db1 --> redis1
    db2 --> redis2
    redis1 -.->|主从复制 · Sentinel 哨兵监控| redis2

    subgraph ESLayer["Elasticsearch 引擎层 · 日志检索 · 数据分析"]
        es1["Elasticsearch-1<br/>日志检索 · 全文搜索 · 端口 9200<br/>JVM: -Xms2g · 数据卷: es_data_1<br/>elasticsearch:7.17.0"]
        es2["Elasticsearch-2<br/>日志检索 · 全文搜索 · 端口 9200<br/>JVM: -Xms2g · 数据卷: es_data_2<br/>elasticsearch:7.17.0"]
    end
    redis1 --> es1
    redis2 --> es2
    es1 -.->|集群分片复制 · Zen Discovery| es2

    infra[Docker 网络：cac-net（bridge，172.20.0.0/16） | 服务发现：容器名 DNS 解析 | 日志：json-file → Filebeat → ELK<br/>私有镜像仓库：Harbor | 编排：docker-compose | CI/CD：Jenkins → Maven → docker build → docker-compose up -d 滚动更新]
    es1 --> infra
    es2 --> infra

    classDef master fill:#bbdefb,stroke:#1976d2
    classDef backup fill:#e1f5fe,stroke:#64b5f6
    classDef infraStyle fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray: 5 5
    class nginx1,gw1,app1,db1,redis1,es1 master
    class nginx2,gw2,app2,db2,redis2,es2 backup
    class infra infraStyle
