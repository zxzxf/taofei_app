{
  "name": "taofei-desktop",
  "version": "1.2.1",
  "description": "淘飞AI · 企业级AI智能体平台",
  "main": "main.js",
  "author": "Taofei",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "start": "node launcher.js",
    "dev": "node launcher.js",
    "dist": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zxzxf/taofei_app.git"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.taofei.workbench",
    "productName": "TaofeiAI",
    "npmRebuild": false,
    "directories": {
      "output": "release_v3",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/CrewAIWorkbench.exe",
        "to": "backend/CrewAIWorkbench.exe"
      },
      {
        "from": "../.env",
        "to": "backend/.env"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TaofeiAI"
    }
  }
}
